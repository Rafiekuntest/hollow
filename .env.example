# Discord Bot Token (REQUIRED)
DISCORD_TOKEN=your_bot_token_here

# Owner IDs (comma-separated)
OWNER_IDS=123456789012345678,987654321098765432

# Default prefix
PREFIX=,

# Database path
DATABASE_PATH=core/schema/hollow.db

# Commands API URL (for docs website)
COMMANDS_API_URL=https://your-vercel-app.vercel.app/api/commands

# ============================================================
# NEW: Development Mode
# ============================================================
# Enable hot-reload, auto dependency install, debug logging
DEV_MODE=false

# ============================================================
# NEW: Sentry Error Tracking
# ============================================================
# Get your DSN from https://sentry.io
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxx
SENTRY_ENVIRONMENT=development  # or production
SENTRY_RELEASE=1.0.0

# ============================================================
# Optional: Database (PostgreSQL example - not implemented yet)
# ============================================================
# DATABASE_URL=postgresql://user:pass@localhost/hollow